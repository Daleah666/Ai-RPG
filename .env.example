# Optional. When set, POST /api/v1/* requires Authorization: Bearer <key> or x-api-key.
SUBLIMINAL_API_KEY=

# Optional. Enriches theme generation with GPT when provided.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Drive OAuth (server connector)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/drive/callback

# Optional Unsplash source for theme stills
UNSPLASH_ACCESS_KEY=
